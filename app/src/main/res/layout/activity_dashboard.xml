<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luxury_black">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- User Avatar Circle -->
        <TextView
            android:id="@+id/avatarInitialText"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textColor="@color/luxury_text_white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            tools:text="AS" />

        <!-- Search Icon -->
        <ImageView
            android:id="@+id/searchButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null"
            app:tint="@color/luxury_text_white" />

        <!-- Calendar Icon -->
        <ImageView
            android:id="@+id/calendarButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_calendar"
            android:contentDescription="@null"
            app:tint="@color/luxury_text_white" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Top Right Pill Button: Sign Out -->
        <TextView
            android:id="@+id/signOutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_classes"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="@string/dashboard_btn_sign_out"
            android:textColor="@color/luxury_text_white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- SCROLLABLE MAIN CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- HORIZONTAL GOAL CARDS CAROUSEL -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- GOAL CARD 1: CHECK-IN GOAL -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/luxury_dark_card_stroke"
                        app:cardBackgroundColor="@color/luxury_dark_card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/goal_check_in_title"
                                android:textColor="@color/luxury_text_dim"
                                android:textSize="11sp"
                                android:letterSpacing="0.08"
                                android:fontFamily="sans-serif-medium" />

                            <!-- Segmented Progress Bar (Mint active + Grey tracks) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/luxury_mint" />

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/luxury_dark_card" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/luxury_track_grey" />

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/luxury_dark_card" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/luxury_track_grey" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/goal_check_in_progress"
                                android:textColor="@color/luxury_text_dim"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- GOAL CARD 2: WEEKLY TARGET -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/luxury_dark_card_stroke"
                        app:cardBackgroundColor="@color/luxury_dark_card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/goal_active_title"
                                android:textColor="@color/luxury_text_dim"
                                android:textSize="11sp"
                                android:letterSpacing="0.08"
                                android:fontFamily="sans-serif-medium" />

                            <!-- Segmented Progress Bar -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/luxury_mint" />

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/luxury_dark_card" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/luxury_mint" />

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/luxury_dark_card" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/luxury_track_grey" />

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/luxury_dark_card" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/luxury_track_grey" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/goal_active_progress"
                                android:textColor="@color/luxury_text_dim"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- HEADLINE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="20dp"
                android:text="@string/dashboard_headline"
                android:textColor="@color/luxury_text_white"
                android:textSize="32sp"
                android:lineSpacingMultiplier="1.08"
                android:fontFamily="sans-serif-black" />

            <!-- MODULE CARDS HORIZONTAL SCROLL (Steps, Workouts, Meals) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- CARD 1: STEP TRACKING (Running Shoes Image) -->
                    <LinearLayout
                        android:id="@+id/cardStepTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Vertical Label ON-DEMAND -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginEnd="6dp"
                            android:layout_marginTop="50dp"
                            android:rotation="-90"
                            android:text="@string/dashboard_badge_on_demand"
                            android:textColor="@color/luxury_text_dim"
                            android:textSize="9sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-bold" />

                        <!-- Image & Text Block -->
                        <LinearLayout
                            android:layout_width="220dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="220dp"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/luxury_dark_card">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/img_step_tracking"
                                    android:contentDescription="@string/module_steps_title" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/module_steps_title"
                                android:textColor="@color/luxury_text_white"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-black"
                                android:lineSpacingMultiplier="1.1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/module_steps_category"
                                android:textColor="@color/luxury_accent_tag"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/module_steps_stat"
                                android:textColor="@color/luxury_text_dim"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CARD 2: WORKOUT TRACKING (Dumbbell Workout Image) -->
                    <LinearLayout
                        android:id="@+id/cardWorkoutTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Vertical Label ON-DEMAND -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginEnd="6dp"
                            android:layout_marginTop="50dp"
                            android:rotation="-90"
                            android:text="@string/dashboard_badge_on_demand"
                            android:textColor="@color/luxury_text_dim"
                            android:textSize="9sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-bold" />

                        <!-- Image & Text Block -->
                        <LinearLayout
                            android:layout_width="220dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="220dp"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/luxury_dark_card">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/img_workout_tracking"
                                    android:contentDescription="@string/module_workout_title" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/module_workout_title"
                                android:textColor="@color/luxury_text_white"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-black"
                                android:lineSpacingMultiplier="1.1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/module_workout_category"
                                android:textColor="@color/luxury_accent_tag"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/module_workout_stat"
                                android:textColor="@color/luxury_text_dim"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CARD 3: MEAL & NUTRITION (Meal Prep Image) -->
                    <LinearLayout
                        android:id="@+id/cardMealTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Vertical Label ON-DEMAND -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginEnd="6dp"
                            android:layout_marginTop="50dp"
                            android:rotation="-90"
                            android:text="@string/dashboard_badge_on_demand"
                            android:textColor="@color/luxury_text_dim"
                            android:textSize="9sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-bold" />

                        <!-- Image & Text Block -->
                        <LinearLayout
                            android:layout_width="220dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="220dp"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/luxury_dark_card">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/img_meal_tracking"
                                    android:contentDescription="@string/module_meal_title" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/module_meal_title"
                                android:textColor="@color/luxury_text_white"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-black"
                                android:lineSpacingMultiplier="1.1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/module_meal_category"
                                android:textColor="@color/luxury_accent_tag"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/module_meal_stat"
                                android:textColor="@color/luxury_text_dim"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/luxury_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- NAV 1: HOME (Active) -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/luxury_text_white"
                android:contentDescription="@string/nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textColor="@color/luxury_text_white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- NAV 2: EXPLORE -->
        <LinearLayout
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_explore"
                app:tint="@color/luxury_text_sub"
                android:contentDescription="@string/nav_explore" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_explore"
                android:textColor="@color/luxury_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- NAV 3: ACTIVITY -->
        <LinearLayout
            android:id="@+id/navActivity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_activity"
                app:tint="@color/luxury_text_sub"
                android:contentDescription="@string/nav_activity" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_activity"
                android:textColor="@color/luxury_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- NAV 4: MORE -->
        <LinearLayout
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_more"
                app:tint="@color/luxury_text_sub"
                android:contentDescription="@string/nav_more" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_more"
                android:textColor="@color/luxury_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
